{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lxe-agent.local/protocol/desktop-stream-batch.schema.json",
  "title": "DesktopStreamBatchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "turn_id", "response_route_id", "emit_id", "seq", "mutations"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "response_route_id": { "type": "string", "minLength": 1 },
    "emit_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "part"],
            "properties": {
              "kind": { "const": "part_updated" },
              "part": { "$ref": "#/$defs/turnProcessPart" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "part_id", "field", "delta"],
            "properties": {
              "kind": { "const": "part_delta" },
              "part_id": { "type": "string", "minLength": 1 },
              "field": { "const": "text" },
              "delta": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "state", "display_metrics"],
            "properties": {
              "kind": { "const": "stream_updated" },
              "state": { "enum": ["delta", "final", "error"] },
              "display_metrics": { "$ref": "#/$defs/displayMetrics" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "turnProcessPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "part_id", "sequence", "status", "text", "redacted_count"],
          "properties": {
            "type": { "const": "thinking" },
            "part_id": { "type": "string", "minLength": 1 },
            "sequence": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["streaming", "completed", "error"] },
            "text": { "type": "string" },
            "redacted_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "part_id", "sequence", "status", "presentation", "text"],
          "properties": {
            "type": { "const": "text" },
            "part_id": { "type": "string", "minLength": 1 },
            "sequence": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["streaming", "completed", "error"] },
            "presentation": { "enum": ["process", "final"] },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "part_id", "sequence", "tool_step"],
          "properties": {
            "type": { "const": "tool" },
            "part_id": { "type": "string", "minLength": 1 },
            "sequence": { "type": "integer", "minimum": 1 },
            "tool_step": { "$ref": "#/$defs/toolStep" }
          }
        }
      ]
    },
    "toolStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "title", "detail", "icon_token", "status", "duration_ms"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "icon_token": { "type": "string", "minLength": 1 },
        "status": { "enum": ["running", "success", "error"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "result_block": { "$ref": "#/$defs/toolDisplayBlock" },
        "error_block": { "$ref": "#/$defs/toolDisplayBlock" }
      }
    },
    "toolDisplayBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "content"],
      "properties": {
        "language": { "enum": ["json", "text"] },
        "content": { "type": "string" }
      }
    },
    "displayMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "phase", "elapsed_ms", "model", "input_tokens", "output_tokens",
        "cache_read_input_tokens", "cache_creation_input_tokens", "context_tokens", "context_window_tokens"
      ],
      "properties": {
        "status": { "enum": ["running", "completed", "error", "cancelled"] },
        "phase": { "enum": ["preparing_context", "waiting_model", "thinking", "running_tool", "generating_answer"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "model": { "type": "string" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "context_window_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
